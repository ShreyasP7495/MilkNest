# Application
APP_ENV=development
APP_PORT=8080
APP_NAME=milknest

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=milk
DB_PASSWORD=milk123
DB_NAME=milknest
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=replace-with-32-byte-random-secret-please
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-secret
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=30

# OTP (Redis-backed)
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MOCK=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS provider (MSG91/Twilio) - left blank for stub
SMS_PROVIDER=stub
SMS_API_KEY=
SMS_SENDER_ID=MILKNT

# FCM (push)
FCM_SERVER_KEY=

# Business rules
MAX_PACKETS_PER_DAY=10
BNPL_SURCHARGE_PERCENT=10

# Cron
ORDER_GEN_CRON=0 0 * * *
TIMEZONE=Asia/Kolkata
